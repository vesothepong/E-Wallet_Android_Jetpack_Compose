# ─────────────────────────────────────────────────────────────────────────────
# POCKETPAY CAMBODIAN BANK & BAKONG KHQR CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Server Port
PORT=8080

# NBC Bakong Open API Base URL
# Sandbox: https://bakong-dev.nbc.gov.kh/v1
# Production: https://api-bakong.nbc.gov.kh/v1
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1

# Your Bakong Developer / Merchant Bearer Token (Issued by NBC or your partner bank)
# Leave blank or default to run in local Sandbox/Demo mode
BAKONG_API_TOKEN=your_bakong_developer_token_here

# Your Bakong Merchant Details (Fill with your real merchant info)
BAKONG_MERCHANT_ID=mch_vesothepong_001
BAKONG_ACCOUNT_ID=vesothepong@abaa
BAKONG_MERCHANT_NAME=PocketPay Store
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_ACQUIRING_BANK=ABA Bank

# Currency: USD or KHR (Cambodian Riel)
CURRENCY=USD
